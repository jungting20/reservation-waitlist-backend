{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "jest", "unicorn"],
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/.next/**",
    "**/next-env.d.ts"
  ],
  "rules": {
    "jest/require-to-throw-message": "off",
    "unicorn/prefer-node-protocol": "off"
  }
}
